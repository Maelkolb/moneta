{
  "name": "moneta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Moneta - a Roman coin identification game built on OCRE and the ANS collection",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "data:fetch": "node scripts/fetch_ocre.ts",
    "data:build": "node scripts/build_dataset.ts",
    "data:map": "node scripts/build_map.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^10.26.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.0",
    "sharp": "^0.35.0",
    "topojson-client": "^3.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "world-atlas": "^2.0.2"
  }
}
